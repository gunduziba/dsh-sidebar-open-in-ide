{
  "name": "dsh-sidebar-open-in-ide",
  "version": "0.3.0",
  "description": "Open files in JetBrains IDEA from the DSH web GUI, via official Streamable HTTP MCP server",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib"
  ],
  "dependencies": {
    "schemastery": "^3.18.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-settings": "^0.1.2-rc.1",
    "dsh-better-sidebar": ">=0.14.0"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "slots",
        "sessions"
      ]
    }
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gunduziba/dsh-sidebar-open-in-ide.git"
  },
  "homepage": "https://github.com/gunduziba/dsh-sidebar-open-in-ide#readme",
  "bugs": {
    "url": "https://github.com/gunduziba/dsh-sidebar-open-in-ide/issues"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "jetbrains",
    "intellij-idea",
    "sidebar",
    "mcp"
  ]
}